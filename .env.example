# Variables à renseigner dans l'UI Coolify (Service > Environment Variables)
# après création du service. Ce fichier n'est PAS chargé par le compose,
# il sert de référence.

# Connection strings Prisma : dashboard Supabase > Connect > ORM > Prisma.
# Copiez les valeurs exactes affichées par Supabase (hôte et région varient).
# DATABASE_URL : pooler en mode Transaction (port 6543), garder ?pgbouncer=true
DATABASE_URL=postgresql://postgres.{PROJECT-REF}:{YOUR-PASSWORD}@aws-0-{REGION}.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL : connexion directe pour les migrations (port 5432, pooler en mode Session)
DIRECT_URL=postgresql://postgres.{PROJECT-REF}:{YOUR-PASSWORD}@aws-0-{REGION}.pooler.supabase.com:5432/postgres

# Clés API Supabase : dashboard > Project Settings > API keys
SUPABASE_URL=https://{PROJECT-REF}.supabase.co
SUPABASE_ANON_PUBLIC={YOUR-ANON-PUBLIC-KEY}
SUPABASE_SERVICE_ROLE={YOUR-SERVICE-ROLE-KEY}

# SMTP pour les emails applicatifs de shelf (invitations, réservations, etc.)
# Peut être le même fournisseur que celui configuré côté Supabase
# (Authentication > Emails > SMTP), qui envoie lui les OTP de connexion.
SMTP_HOST=smtp.{YOUR-PROVIDER}.com
SMTP_PORT=465
SMTP_USER={YOUR-USERNAME}
SMTP_PWD={YOUR-PASSWORD}
SMTP_FROM="Shelf <noreply@shelf.example.com>"

# Optionnel : cartes MapTiler (https://www.maptiler.com, free tier)
MAPTILER_TOKEN={YOUR-MAPTILER-TOKEN}
# Optionnel : User-Agent envoyé au géocodeur OpenStreetMap Nominatim
GEOCODING_USER_AGENT=Shelf self-hosted (https://shelf.example.com)

# Note : SESSION_SECRET, INVITE_TOKEN_SECRET et FINGERPRINT sont auto-générés
# par Coolify via les magic vars SERVICE_BASE64_64_* du compose, rien à fournir.
