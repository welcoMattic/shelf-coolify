# Variables à renseigner dans l'UI Coolify (Service > Environment Variables) après
# création du service. Ce fichier n'est PAS chargé par le compose, il sert de référence.
# Toutes ces variables sont optionnelles pour le boot : la stack démarre même sans elles.
# Elles ne conditionnent que l'envoi d'emails et l'affichage des cartes.

# SMTP pour les emails applicatifs de shelf (invitations, réservations, etc.)
# ET pour les emails de GoTrue (OTP de connexion). Les MÊMES identifiants sont utilisés
# pour les deux surfaces. Sans SMTP, aucun email ne part (pas de connexion par OTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-username
SMTP_PWD=your-password
# Format pour shelf : "Nom <email>"
SMTP_FROM="Shelf <noreply@shelf.example.com>"
# Expéditeur des OTP GoTrue (optionnel)
SMTP_ADMIN_EMAIL=noreply@shelf.example.com
# Nom de l'expéditeur des OTP GoTrue (défaut : Shelf)
SMTP_SENDER_NAME=Shelf

# Optionnel : cartes MapTiler (https://www.maptiler.com, free tier)
MAPTILER_TOKEN=
# Optionnel : User-Agent envoyé au géocodeur OpenStreetMap Nominatim
GEOCODING_USER_AGENT=Shelf self-hosted (https://shelf.example.com)

# Note : tous les secrets (Postgres, JWT, clés anon/service, session) sont auto-générés
# par Coolify via les magic vars SERVICE_*, rien à fournir.
